{
  "name": "speak-in-character",
  "version": "0.5.0",
  "private": true,
  "description": "InCharacter — a voice companion for roleplayers",
  "main": "dist-electron/main.js",
  "author": "InCharacter contributors",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.electron.json",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "dist:win": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.5.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "io.incharacter.speak",
    "productName": "InCharacter",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "InCharacter-${version}-Windows-${arch}.${ext}"
    },
    "extraResources": [{ "from": "native/hotkey.exe", "to": "native/hotkey.exe" }],
    "npmRebuild": false
  }
}
